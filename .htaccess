Options -Indexes
Options -MultiViews
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /githubanwar/spk_saw_php_mvc/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?url=$1 [L]
    #RewriteRule ^(.+)$ index.php?url=$1 [QSA,L]
</IfModule>
